     4→
     5→Express.js uses method functions and Router to define API endpoints. This guide covers all patterns for enumerating API endpoints in Express.js applications.
     6→
     7→---
     8→
     9→## 1. App.METHOD Patterns
    10→
    11→Express provides methods corresponding to HTTP verbs on the `app` object:
    12→
    13→| HTTP Method | Function | Description |
    14→|-------------|----------|-------------|
    15→| GET | `app.get()` | Retrieve data |
    16→| POST | `app.post()` | Create resource |
    17→| PUT | `app.put()` | Replace resource |
    18→| DELETE | `app.delete()` | Delete resource |
    19→| PATCH | `app.patch()` | Partial update |
    20→| OPTIONS | `app.options()` | CORS preflight |
    21→| TRACE | `app.trace()` | Diagnostic trace |
    22→| ALL | `app.all()` | Match all methods |
    23→
    24→### 1.1 Basic Route Definitions
    25→
    26→```javascript
    27→const express = require('express');
    28→const app = express();
    29→
    30→// GET request
    31→app.get('/users', (req, res) => {
    32→    res.json([{ id: 1, name: 'John' }]);
    33→});
    34→
    35→// POST request
    36→app.post('/users', (req, res) => {
    37→    res.status(201).json({ created: true });
    38→});
    39→
    40→// PUT request with route parameter
    41→app.put('/users/:id', (req, res) => {
    42→    res.json({ updated: true });
    43→});
    44→
    45→// DELETE request
    46→app.delete('/users/:id', (req, res) => {
    47→    res.status(204).send();
    48→});
    49→
    50→// Handle all HTTP methods
    51→app.all('/secret', (req, res, next) => {
    52→    console.log('Accessing secret section...');
    53→    next();
    54→});
    55→```
    56→
    57→### 1.2 Method Signature
    58→
    59→All methods follow the same signature:
    60→
    61→```javascript
    62→app.METHOD(path, callback [, callback ...])
    63→```
    64→
    65→---
    66→
    67→## 2. express.Router() Patterns
    68→
    69→### 2.1 Creating Routers
    70→
    71→```javascript
    72→// routes/users.js
    73→const express = require('express');
    74→const router = express.Router();
    75→
    76→// Router-specific middleware
    77→router.use((req, res, next) => {
    78→    console.log('Users router middleware');
    79→    next();
    80→});
    81→
    82→router.get('/', (req, res) => {
    83→    res.json([{ id: 1, name: 'John' }]);
    84→});
    85→
    86→router.get('/:id', (req, res) => {
    87→    res.json({ id: req.params.id, name: 'John' });
    88→});
    89→
    90→router.post('/', (req, res) => {
    91→    res.status(201).json({ id: Date.now(), ...req.body });
    92→});
    93→
    94→module.exports = router;
    95→```
    96→
    97→### 2.2 Mounting Routers
    98→
    99→```javascript
   100→// app.js
   101→const express = require('express');
   102→const usersRouter = require('./routes/users');
   103→const app = express();
   104→
   105→// Mount router at path
   106→app.use('/api/v1/users', usersRouter);
   107→
   108→// Mount at multiple paths
   109→app.use('/api/v2/users', usersRouter);
   110→```
   111→
   112→---
   113→
   114→## 3. Route Chaining (app.route())
   115→
   116→Chain multiple HTTP method handlers for the same path:
   117→
   118→```javascript
   119→const express = require('express');
   120→const app = express();
   121→
   122→app.route('/book')
   123→    .get((req, res) => {
   124→        res.json({ books: ['Book 1', 'Book 2'] });
   125→    })
   126→    .post((req, res) => {
   127→        res.status(201).json({ created: true });
   128→    })
   129→    .put((req, res) => {
   130→        res.json({ updated: true });
   131→    });
   132→
   133→app.route('/book/:id')
   134→    .get((req, res) => {
   135→        res.json({ id: req.params.id, title: 'Sample Book' });
   136→    })
   137→    .delete((req, res) => {
   138→        res.status(204).send();
   139→    });
   140→```
   141→
   142→---
   143→
   144→## 4. Middleware Patterns
   145→
   146→### 4.1 Application-Level Middleware
   147→
   148→```javascript
   149→const express = require('express');
   150→const app = express();
   151→
   152→// Global middleware (every request)
   153→app.use((req, res, next) => {
   154→    req.requestTime = Date.now();
   155→    next();
   156→});
   157→
   158→// Path-specific middleware
   159→app.use('/api', (req, res, next) => {
   160→    const apiKey = req.query['api-key'];
   161→    if (!apiKey) {
   162→        return res.status(400).json({ error: 'API key required' });
   163→    }
   164→    next();
   165→});
   166→```
   167→
   168→### 4.2 Route-Specific Middleware
   169→
   170→```javascript
   171→function loadUser(req, res, next) {
   172→    req.user = { id: req.params.id, name: 'John' };
   173→    next();
   174→}
   175→
   176→function checkAuth(req, res, next) {
   177→    if (!req.user) {
   178→        return res.status(401).json({ error: 'Unauthorized' });
   179→    }
   180→    next();
   181→}
   182→
   183→// Chain middleware with handler
   184→app.get('/user/:id', loadUser, (req, res) => {
   185→    res.json(req.user);
   186→});
   187→
   188→// Multiple middleware
   189→app.get('/user/:id/edit', loadUser, checkAuth, (req, res) => {
   190→    res.json({ message: `Editing ${req.user.name}` });
   191→});
   192→```
   193→
   194→---
   195→
   196→## 5. Dynamic Route Parameters
   197→
   198→### 5.1 Named Parameters
   199→
   200→```javascript
   201→// Single parameter
   202→app.get('/user/:id', (req, res) => {
   203→    res.json({ id: req.params.id });
   204→});
   205→
   206→// Multiple parameters
   207→app.get('/users/:userId/posts/:postId', (req, res) => {
   208→    res.json({
   209→        userId: req.params.userId,
   210→        postId: req.params.postId
   211→    });
   212→});
   213→
   214→// Parameter separators
   215→app.get('/users/:from-:to', (req, res) => {
   216→    res.json({ from: req.params.from, to: req.params.to });
   217→});
   218→```
   219→
   220→### 5.2 Wildcard Parameters
   221→
   222→```javascript
   223→// Wildcard captures everything after prefix
   224→app.get('/files/*file', (req, res) => {
   225→    // req.params.file is an array of path segments
   226→    res.send(`Requested file: ${req.params.file.join('/')}`);
   227→});
   228→
   229→// Splat pattern for glob-like matching (Express 5.x)
   230→app.all('/api/{*splat}', requireAuthentication);
   231→```
   232→
   233→### 5.3 Regular Expression Routes
   234→
   235→```javascript
   236→// Match /user/ followed by numeric ID
   237→app.get(/user\/(\d+)/, (req, res) => {
   238→    res.send(`User ID: ${req.params[0]}`);
   239→});
   240→```
   241→
   242→---
   243→
   244→## 6. Locating Handler Functions
   245→
   246→### 6.1 Handler Definition Patterns
   247→
   248→```javascript
   249→// Pattern 1: Inline handler functions
   250→app.get('/endpoint', (req, res) => { ... });
   251→
   252→// Pattern 2: Named function references
   253→function handler(req, res) { ... }
   254→app.get('/endpoint', handler);
   255→
   256→// Pattern 3: Controller exports
   257→const UserController = require('./controllers/user');
   258→app.get('/users', UserController.list);
   259→
   260→// Pattern 4: Async handlers
   261→app.post('/endpoint', async (req, res, next) => {
   262→    try {
   263→        const result = await someAsyncOperation();
   264→        res.json(result);
   265→    } catch (err) {
   266→        next(err);
   267→    }
   268→});
   269→
   270→// Pattern 5: Chained handlers via app.route()
   271→app.route('/endpoint')
   272→    .get(handler1)
   273→    .post(handler2);
   274→```
   275→
   276→### 6.2 Key Files to Check
   277→
   278→| Directory | Purpose |
   279→|-----------|---------|
   280→| `routes/` | Route definitions (e.g., `routes/users.js`) |
   281→| `controllers/` | Controller modules |
   282→| `api/` | API route files |
   283→| `app.js` / `server.js` | Main application file |
   284→
   285→### 6.3 AST Search Patterns
   286→
   287→```javascript
   288→// Search app.METHOD patterns
   289→ast_grep_search(pattern='app.get($PATH, $$$)', lang='javascript')
   290→ast_grep_search(pattern='app.post($PATH, $$$)', lang='javascript')
   291→ast_grep_search(pattern='app.put($PATH, $$$)', lang='javascript')
   292→ast_grep_search(pattern='app.delete($PATH, $$$)', lang='javascript')
   293→
   294→// Search router.METHOD patterns
   295→ast_grep_search(pattern='router.get($PATH, $$$)', lang='javascript')
   296→ast_grep_search(pattern='router.post($PATH, $$$)', lang='javascript')
   297→
   298→// Search app.route patterns
   299→ast_grep_search(pattern='app.route($PATH)', lang='javascript')
   300→
   301→// Search express.Router() instantiation
   302→ast_grep_search(pattern='express.Router()', lang='javascript')
   303→```
   304→
   305→### 6.4 Regex Search Patterns
   306→
   307→```regex
   308→(app|router)\.(get|post|put|delete|patch|all|options)\s*\(
   309→app\.route\s*\(
   310→express\.Router\s*\(
   311→app\.use\s*\(['"]\/[^'"]+['"]
   312→```
   313→
   314→---
   315→
   316→## 7. Complete HTTP Method List
   317→
   318→| Method | HTTP Verb | Purpose |
   319→|--------|-----------|---------|
   320→| `app.all()` | All | Match all HTTP methods |
   321→| `app.get()` | GET | Retrieve data |
   322→| `app.post()` | POST | Create resource |
   323→| `app.put()` | PUT | Replace resource |
   324→| `app.delete()` | DELETE | Remove resource |
   325→| `app.patch()` | PATCH | Partial update |
   326→| `app.options()` | OPTIONS | CORS preflight |
   327→| `app.trace()` | TRACE | Diagnostic trace |
   328→
   329→---
   330→
   331→## 8. Security Audit Checklist
   332→
   333→- [ ] Identify all `app.METHOD()` and `router.METHOD()` calls
   334→- [ ] Trace all `app.use()` router mounts
   335→- [ ] Check middleware ordering (auth before sensitive operations)
   336→- [ ] Verify input validation on route parameters
   337→- [ ] Look for exposed sensitive endpoints
   338→- [ ] Check for HTTP method bypass vulnerabilities
   339→- [ ] Verify error handlers don't leak sensitive information
   340→- [ ] Check cross-route parameter handling for privilege escalation
   341→
   342→
